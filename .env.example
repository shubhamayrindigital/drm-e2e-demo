# Backend config
BACKEND_PORT=3000
NODE_ENV=development
JWT_SECRET=your-secret-change-me-in-prod
JWT_EXPIRY_HOURS=24

# Cloudflare R2 (fill in after r2-setup.md)
CF_ACCOUNT_ID=your-account-id
CF_BUCKET_NAME=drm-poc
CF_R2_ACCESS_KEY_ID=your-access-key-id
CF_R2_SECRET_ACCESS_KEY=your-secret-access-key
CF_R2_ENDPOINT=https://drm-poc.r2.dev

# Database
DATABASE_URL=file:./prisma/dev.db

# Widevine license server (POC uses Google UAT)
WIDEVINE_LICENSE_SERVER_URL=https://proxy.uat.widevine.com/proxy

# Android emulator / physical device (set after ngrok tunnel if needed)
ANDROID_API_URL=http://localhost:3000
# Or for physical device via ngrok:
# ANDROID_API_URL=https://abc123.ngrok.io

# Web dev server
WEB_DEV_PORT=5173
